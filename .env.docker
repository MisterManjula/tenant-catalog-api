# Environment for docker compose. Committed on purpose: every value here is for local
# use only. APP_KEY was generated for this repo and protects nothing real.
APP_NAME=tenant-catalog-api
APP_ENV=local
APP_KEY=base64:iQ3kvjDFMWNM3AeDwY4cg3vlYyo9D3zuMBa7vNUOls0=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Logs go to stderr so they show up in `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=catalog
DB_USERNAME=catalog
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array
